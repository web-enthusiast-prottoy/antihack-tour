rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.admin == true;
    }
    function owner() {
      return admin() && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.owner == true;
    }
    function accountAllowed(uid) {
      let path = /databases/$(database)/documents/accountBans/$(uid);
      return !exists(path) || get(path).data.active == false;
    }
    function activeAccount() { return request.auth != null && accountAllowed(request.auth.uid); }
    function matchAllowed(uid, id) {
      let path = /databases/$(database)/documents/matches/$(id)/bans/$(uid);
      return accountAllowed(uid) && (!exists(path) || get(path).data.active == false);
    }
    function validBan(path, key) {
      let d = request.resource.data;
      return admin() && !exists(/databases/$(database)/documents/staffRoles/$(d.uid)) &&
        exists(/databases/$(database)/documents/users/$(d.uid)) &&
        d.keys().hasAll(['uid','active','reason','revision','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['uid','active','reason','revision','updatedAt','updatedBy']) &&
        d.active is bool && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 1000 &&
        d.reason.matches('(?s).*\\S.*') && d.updatedAt == request.time && d.updatedBy == request.auth.uid &&
        d.revision is int && d.revision == (resource == null ? 1 : resource.data.revision + 1) &&
        audited('ban_' + key + '_' + string(d.revision), 'moderatePlayer', path) &&
        getAfter(/databases/$(database)/documents/auditRecords/$('ban_' + key + '_' + string(d.revision))).data.reason == d.reason;
    }
    match /accountBans/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow create, update: if request.resource.data.uid == uid && validBan('accountBans/' + uid, 'account_' + uid);
    }
    match /matches/{id}/bans/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow create, update: if request.resource.data.uid == uid &&
        exists(/databases/$(database)/documents/entries/$(uid + '_' + id)) && validBan('matches/' + id + '/bans/' + uid, 'match_' + id + '_' + uid);
    }
    function bounded() { return request.query.limit != null && request.query.limit <= 100; }
    function validArtwork(d) {
      let id=d.get('artworkId','');
      return id is string && id.size() <= 100 && (id == '' || existsAfter(/databases/$(database)/documents/artwork/$(id)));
    }
    function freeSeatClaim(id) {
      let uid = request.auth.uid;
      let entry = /databases/$(database)/documents/entries/$(uid + '_' + id);
      return resource.data.status == 'open' && resource.data.entryPaisa == 0 &&
        resource.data.get('joined', 0) is int && resource.data.get('joined', 0) >= 0 &&
        resource.data.get('joined', 0) < resource.data.capacity &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined']) &&
        request.resource.data.joined is int &&
        request.resource.data.joined == resource.data.get('joined', 0) + 1 &&
        !exists(entry) && getAfter(entry).data.uid == uid &&
        getAfter(entry).data.match == id && getAfter(entry).data.status == 'confirmed';
    }
    function publisher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.notices == true;
    }
    function validNotice() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'body', 'published', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision']) &&
        d.keys().hasAll(['title', 'body', 'published', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 80 && d.title.matches('.*\\S.*') &&
        d.body is string && d.body.size() > 0 && d.body.size() <= 600 && d.body.matches('[\\s\\S]*\\S[\\s\\S]*') &&
        d.published is bool && d.createdAt is timestamp && d.updatedAt == request.time &&
        d.createdBy is string && d.updatedBy == request.auth.uid && d.revision is int;
    }
    match /notices/{noticeId} {
      allow get: if resource.data.published == true || publisher();
      allow list: if request.query.limit != null && request.query.limit <= 50 &&
        (resource.data.published == true || publisher());
      allow create: if publisher() && validNotice() && request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.revision == 1;
      allow update: if publisher() && validNotice() &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /staffRoles/{uid} {
      allow get: if activeAccount() && (request.auth.uid == uid || owner());
      allow list: if owner() && bounded();
      allow create, update: if owner() && uid != request.auth.uid &&
        (!exists(/databases/$(database)/documents/staffRoles/$(uid)) || resource.data.get('owner', false) == false) &&
        request.resource.data.keys().hasOnly(['admin','notices','updatedAt','updatedBy']) &&
        request.resource.data.admin is bool && request.resource.data.notices is bool &&
        request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    function validScheduleTemplate(t) {
      return t.keys().hasAll(['title','description','image','mode','map','capacity','entryPaisa','prizePaisa','perKillPaisa','rules','cancellationTerms','categoryId','artworkId']) &&
        t.keys().hasOnly(['title','description','image','mode','map','capacity','entryPaisa','prizePaisa','perKillPaisa','rules','cancellationTerms','categoryId','artworkId']) &&
        t.title is string && t.title.size() > 0 && t.title.size() <= 80 && t.title.matches('(?s).*\\S.*') &&
        t.description is string && t.description.size() <= 4000 && t.map is string && t.map.size() <= 1000 &&
        t.image in ['solo','duo','squad'] && t.mode in ['solo','duo','squad'] &&
        t.capacity is int && t.capacity >= 1 && t.capacity <= 1000 &&
        t.entryPaisa is int && t.entryPaisa >= 0 && t.entryPaisa <= 9007199254740991 &&
        t.prizePaisa is int && t.prizePaisa > 0 && t.prizePaisa <= 9007199254740991 &&
        t.perKillPaisa is int && t.perKillPaisa >= 0 && t.perKillPaisa <= 9007199254740991 &&
        t.rules is string && t.rules.size() <= 4000 && t.cancellationTerms is string && t.cancellationTerms.size() <= 4000 &&
        t.categoryId is string && t.categoryId.size() <= 150 && (t.categoryId == '' || get(/databases/$(database)/documents/categories/$(t.categoryId)).data.active == true) && validArtwork(t);
    }
    match /matchSchedules/{id} {
      allow read: if admin() && (request.method == 'get' || bounded());
      allow create: if admin() && id.matches('[A-Za-z0-9]{20}') &&
        request.resource.data.keys().hasAll(['template','prizes','dateFrom','dateTo','fromMinute','toMinute','delayMinutes','timezone','state','revision','createdAt','createdBy','updatedAt','updatedBy']) &&
        request.resource.data.keys().hasOnly(['template','prizes','dateFrom','dateTo','fromMinute','toMinute','delayMinutes','timezone','state','revision','createdAt','createdBy','updatedAt','updatedBy']) &&
        validScheduleTemplate(request.resource.data.template) && request.resource.data.prizes is list &&
        request.resource.data.prizes.size() >= 1 && request.resource.data.prizes.size() <= 400 && request.resource.data.prizes.size() <= request.resource.data.template.capacity &&
        request.resource.data.dateFrom is string && request.resource.data.dateFrom.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        request.resource.data.dateTo is string && request.resource.data.dateTo.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.dateFrom <= request.resource.data.dateTo &&
        request.resource.data.fromMinute is int && request.resource.data.fromMinute >= 0 &&
        request.resource.data.toMinute is int && request.resource.data.toMinute <= 1439 && request.resource.data.toMinute > request.resource.data.fromMinute &&
        request.resource.data.delayMinutes is int && request.resource.data.delayMinutes >= 1 && request.resource.data.delayMinutes <= 1440 &&
        request.resource.data.timezone == 'Asia/Dhaka' && request.resource.data.state == 'active' && request.resource.data.revision == 1 &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time &&
        audited('schedule_' + id + '_1','saveMatchSchedule','matchSchedules/' + id);
      allow update: if admin() && resource.data.state in ['active','paused'] && request.resource.data.state in ['active','paused','stopped','completed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','revision','updatedAt','updatedBy']) &&
        request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid &&
        audited('schedule_' + id + '_' + string(request.resource.data.revision),'saveMatchSchedule','matchSchedules/' + id);
      match /runs/{run} {
        allow read: if admin() && (request.method == 'get' || bounded());
        allow create: if admin() && validScheduledRun(id,run);
      }
    }
    match /schedulerStatus/{id} {
      allow read: if admin() && id == 'matches' && request.method == 'get';
    }
    match /matchScheduleProgress/{id} {
      allow read: if admin() && (request.method == 'get' || bounded());
      allow create, update: if admin() && validScheduleProgress(id);
    }
    function validScheduledRun(id, run) {
      let s = get(/databases/$(database)/documents/matchSchedules/$(id)).data;
      let p = getAfter(/databases/$(database)/documents/matchScheduleProgress/$(id)).data;
      let d = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/matches/$(d.match)).data;
      return s.state == 'active' && d.keys().hasAll(['sequence','match','createdAt','scheduleRevision']) &&
        d.keys().hasOnly(['sequence','match','createdAt','scheduleRevision','startsAt']) && d.sequence is int && d.sequence >= 1 &&
        run == string(d.sequence) && d.match == 'schedule_' + id + '_' + run &&
        d.createdAt == request.time && d.scheduleRevision == s.revision &&
        (!('startsAt' in d) || (d.startsAt is timestamp && d.startsAt == m.startsAt)) &&
        p.sequence == d.sequence && p.lastMatch == d.match && p.phase in ['publishing','waiting'] && p.updatedAt == request.time &&
        !exists(/databases/$(database)/documents/matches/$(d.match)) &&
        m.diff(s.template).affectedKeys().hasOnly(['startsAt','joined','status','revision','cancellationReason','independentPrizeTotal','prizesEnabled','prizeRank','prizeMaxRank','updatedAt','updatedBy']) &&
        ((p.phase == 'publishing' && m.status == 'draft') || (p.phase == 'waiting' && m.status == 'open')) &&
        m.revision == 1 && m.joined == 0 && m.prizesEnabled == true && m.prizeMaxRank == s.prizes.size();
    }
    // Scheduling is an admin operation, like manually creating matches. Financial credit rules stay unchanged.
    function validScheduleProgress(id) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      let s = get(/databases/$(database)/documents/matchSchedules/$(id)).data;
      return d.keys().hasAll(['sequence','lastMatch','phase','nextAt','error','updatedAt']) &&
        d.keys().hasOnly(['sequence','lastMatch','phase','nextAt','error','updatedAt']) &&
        s.state == 'active' && d.updatedAt == request.time && d.sequence is int && d.sequence >= 0 &&
        d.lastMatch is string && d.error is string && d.error.size() <= 1000 &&
        (d.nextAt == null || d.nextAt is timestamp) && d.phase in ['publishing','waiting','queued','blocked','completed'] &&
        ((d.sequence == old.get('sequence',0) && d.lastMatch == old.get('lastMatch','') &&
          (d.phase != 'publishing' || old.get('phase','') == 'publishing') &&
          (old.get('phase','') != 'publishing' || d.phase != 'waiting' || getAfter(/databases/$(database)/documents/matches/$(d.lastMatch)).data.status != 'draft')) ||
         (d.sequence == old.get('sequence',0) + 1 && old.get('phase','') != 'publishing' &&
          d.lastMatch == 'schedule_' + id + '_' + string(d.sequence) && d.phase in ['publishing','waiting'] &&
          !exists(/databases/$(database)/documents/matchSchedules/$(id)/runs/$(string(d.sequence))) &&
          getAfter(/databases/$(database)/documents/matchSchedules/$(id)/runs/$(string(d.sequence))).data.match == d.lastMatch &&
          getAfter(/databases/$(database)/documents/matchSchedules/$(id)/runs/$(string(d.sequence))).data.createdAt == request.time));
    }
    match /matches/{id} {
      allow delete: if owner() && audited('deleteMatch_' + id,'deleteMatch','matches/' + id);
      // A free seat and its immutable entry must be committed together. No wallet writes.
      allow update: if activeAccount() && freeSeatClaim(id);
      allow update: if activeAccount() && request.resource.data.keys().hasAll(['lastEntry']) && paidSeatClaim(id);
      allow read: if (admin() || resource.data.status != 'draft') && (request.method == 'get' || bounded() || admin());
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['independentPrizeTotal','lastEntry','prizesEnabled','prizeRank','prizeMaxRank','joined','artworkId','categoryId','title','description','image','mode','map','startsAt','capacity','entryPaisa','prizePaisa','perKillPaisa','rules','cancellationTerms','status','updatedAt','updatedBy','revision','cancellationReason','cancelledAt']) &&
        request.resource.data.get('joined',0) == (resource == null ? 0 : resource.data.get('joined',0)) &&
        validArtwork(request.resource.data) && request.resource.data.get('categoryId','') is string && (request.resource.data.get('categoryId','') == '' ||
          (exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)) &&
           ((resource != null && request.resource.data.categoryId == resource.data.get('categoryId','')) ||
            get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)).data.active == true))) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 4000 &&
        request.resource.data.image in ['solo','duo','squad'] && request.resource.data.mode in ['solo','duo','squad'] &&
        request.resource.data.map is string && request.resource.data.map.size() <= 1000 &&
        request.resource.data.startsAt is timestamp && request.resource.data.capacity is int && request.resource.data.capacity > 0 && request.resource.data.capacity <= 1000 && request.resource.data.capacity >= request.resource.data.get('joined',0) &&
        request.resource.data.entryPaisa is int && request.resource.data.entryPaisa >= 0 &&
        request.resource.data.prizePaisa is int && request.resource.data.prizePaisa >= 0 &&
        request.resource.data.perKillPaisa is int && request.resource.data.perKillPaisa >= 0 &&
        request.resource.data.rules is string && request.resource.data.rules.size() <= 4000 &&
        request.resource.data.cancellationTerms is string && request.resource.data.cancellationTerms.size() <= 4000 &&
        request.resource.data.status in ['draft','open','closed','live','review','settled','cancelled'] &&
        request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && validMatchChange(id) && validPrizeSummary(id);
    }
    function prizeDelta(id, d, old) {
      let path = /databases/$(database)/documents/matches/$(id)/prizes/$(string(d.prizeRank));
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      let enabled = old.get('prizesEnabled',false);
      let maxRank = old.get('prizeMaxRank',0);
      return (enabled || !exists(path)) && d.prizeRank >= 1 && d.prizeRank <= d.capacity &&
        after.rank == d.prizeRank && after.matchRevision == d.revision && after.updatedAt == request.time &&
        (d.get('independentPrizeTotal',false) ? d.prizePaisa == old.prizePaisa : d.prizePaisa == (enabled ? old.prizePaisa : 0) - before.get('amountPaisa',0) + after.amountPaisa) &&
        d.prizeMaxRank == (d.prizeRank > maxRank ? d.prizeRank : maxRank);
    }
    function validPrizeSummary(id) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      return d.get('independentPrizeTotal',false) is bool &&
        (resource == null || d.get('independentPrizeTotal',false) == old.get('independentPrizeTotal',false)) &&
        d.prizePaisa <= 9007199254740991 && d.get('prizesEnabled',false) is bool && d.get('prizeRank',0) is int &&
        d.get('prizeMaxRank',0) is int && d.get('prizeMaxRank',0) >= 0 && d.get('prizeMaxRank',0) <= d.capacity &&
        (!d.get('prizesEnabled',false) ?
          (!old.get('prizesEnabled',false) && d.get('prizeRank',0) == 0 && d.get('prizeMaxRank',0) == 0) :
          (d.prizePaisa <= 9007199254740991 &&
            ((resource == null && d.get('independentPrizeTotal',false) && d.prizeRank == 0) ||
            (old.get('prizesEnabled',false) && (d.get('independentPrizeTotal',false) || d.prizePaisa == old.prizePaisa) && d.prizeRank == old.prizeRank && d.prizeMaxRank == old.prizeMaxRank) || prizeDelta(id,d,old))));
    }
    match /matches/{id}/prizes/{rank} {
      allow read: if (admin() || get(/databases/$(database)/documents/matches/$(id)).data.status != 'draft') &&
        (request.method == 'get' || bounded());
      allow create, update: if admin() && validPrizePosition(id,rank);
    }
    function validPrizePosition(id, rank) {
      let d = request.resource.data;
      let old = exists(/databases/$(database)/documents/matches/$(id)) ? get(/databases/$(database)/documents/matches/$(id)).data : {};
      let m = getAfter(/databases/$(database)/documents/matches/$(id)).data;
      return d.keys().hasAll(['rank','amountPaisa','matchRevision','updatedAt']) &&
        d.keys().hasOnly(['rank','amountPaisa','matchRevision','updatedAt']) &&
        d.rank is int && rank == string(d.rank) && d.rank >= 1 && d.rank <= m.capacity &&
        d.amountPaisa is int && d.amountPaisa >= 0 && d.amountPaisa <= 9007199254740991 &&
        d.matchRevision == m.revision && m.revision == old.get('revision',0) + 1 &&
        m.prizesEnabled == true && d.updatedAt == request.time &&
        ((old.size() == 0 && m.get('independentPrizeTotal',false) && m.status in ['draft','open'] && m.prizeRank == 0 && d.rank <= m.prizeMaxRank) ||
         (m.status == old.status && m.prizeRank == d.rank && prizeDelta(id,m,old)));
    }
    function settlementComplete(id, old) {
      let progress = getAfter(/databases/$(database)/documents/matchSettlements/$(id)).data;
      return progress.processed == old.get('joined',0) && progress.placementPaisa <= old.prizePaisa && progress.creditedPaisa <= 9007199254740991;
    }
    function validMatchChange(id) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      let from = old.get('status','none');
      let event = getAfter(/databases/$(database)/documents/matches/$(id)/history/$(string(d.revision))).data;
      return d.get('lastEntry','') == old.get('lastEntry','') && d.revision is int && d.revision == old.get('revision',0) + 1 &&
        ((from in ['cancelled','settled'] && d.status == from && d.diff(old).affectedKeys().hasOnly(['prizesEnabled','prizeRank','prizeMaxRank','prizePaisa','revision','updatedAt','updatedBy'])) ||
         (from == 'none' && d.status in ['draft','open']) ||
         (from in ['draft','open','closed','live','review'] && (d.status == from ||
          (from == 'draft' && d.status == 'open') || (from == 'open' && d.status == 'closed') ||
          (from == 'closed' && d.status == 'live') || (from == 'live' && d.status == 'review') ||
          (from == 'review' && d.status == 'settled' && settlementComplete(id,old)) ||
          (d.status == 'cancelled' && from in ['draft','open','closed','live'])))) &&
        (old.get('joined',0) == 0 || !d.diff(old).affectedKeys().hasAny(['mode','map','startsAt','capacity','entryPaisa','perKillPaisa','rules','cancellationTerms'])) &&
        (d.status != 'cancelled' ? (d.get('cancellationReason','') == '' && !('cancelledAt' in d)) :
          (d.cancellationReason is string && d.cancellationReason.size() > 0 && d.cancellationReason.size() <= 1000 && d.cancellationReason.matches('(?s).*\\S.*') && (d.cancelledAt == request.time || (from == 'cancelled' && d.cancelledAt == old.cancelledAt && d.cancellationReason == old.cancellationReason)))) &&
        event.keys().hasAll(['from','to','reason','at']) && event.keys().hasOnly(['from','to','reason','at']) &&
        event.from == from && event.to == d.status && event.reason == d.get('cancellationReason','') && event.at == request.time &&
        audited('match_' + id + '_' + string(d.revision),'saveMatch','matches/' + id);
    }
    match /matches/{id}/history/{revision} {
      allow read: if activeAccount() && (admin() || get(/databases/$(database)/documents/matches/$(id)).data.status != 'draft') &&
        (request.method == 'get' || (request.query.limit != null && request.query.limit <= 21));
      allow create: if admin() && revision == string(getAfter(/databases/$(database)/documents/matches/$(id)).data.revision) &&
        getAfter(/databases/$(database)/documents/matches/$(id)).data.revision == (exists(/databases/$(database)/documents/matches/$(id)) ? get(/databases/$(database)/documents/matches/$(id)).data.get('revision',0) : 0) + 1 &&
        request.resource.data.to == getAfter(/databases/$(database)/documents/matches/$(id)).data.status &&
        request.resource.data.at == request.time;
    }
    function audited(id, action, path) {
      let a = getAfter(/databases/$(database)/documents/auditRecords/$(id)).data;
      return a.action == action && a.path == path && a.actor == request.auth.uid && a.at == request.time;
    }
    match /rooms/{id} {
      allow get: if admin() || (activeAccount() && matchAllowed(request.auth.uid,id) && resource.data.enabled == true &&
        request.time >= resource.data.releaseAt &&
        get(/databases/$(database)/documents/matches/$(id)).data.status in ['open','closed','live'] &&
        get(/databases/$(database)/documents/entries/$(request.auth.uid + '_' + id)).data.status == 'confirmed');
      allow list: if admin() && bounded();
      allow create, update: if admin() &&
        request.resource.data.keys().hasAll(['roomId','password','releaseAt','enabled','revision','updatedAt','updatedBy']) &&
        request.resource.data.keys().hasOnly(['roomId','password','releaseAt','enabled','revision','updatedAt','updatedBy']) &&
        request.resource.data.roomId is string && request.resource.data.roomId.size() > 0 && request.resource.data.roomId.size() <= 100 &&
        request.resource.data.password is string && request.resource.data.password.size() > 0 && request.resource.data.password.size() <= 100 &&
        request.resource.data.releaseAt is timestamp && request.resource.data.enabled is bool &&
        request.resource.data.revision is int && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1) &&
        request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid &&
        exists(/databases/$(database)/documents/matches/$(id)) &&
        audited('room_' + id + '_' + string(request.resource.data.revision), 'saveRoom', 'rooms/' + id);
    }
    function resultAward(matchId, m, placement, kills, award) {
      let row = /databases/$(database)/documents/matches/$(matchId)/prizes/$(string(placement));
      let prize = exists(row) ? get(row).data.amountPaisa : 0;
      return award is int && award >= 0 && award <= 9007199254740991 && (!m.get('prizesEnabled',false) || placement <= m.capacity) &&
        (m.get('prizesEnabled',false) ? award == prize + m.perKillPaisa * kills : award <= m.prizePaisa + m.perKillPaisa * kills);
    }
    function validResultDraft(id) {
      let d = request.resource.data;
      let e = get(/databases/$(database)/documents/entries/$(id)).data;
      let m = get(/databases/$(database)/documents/matches/$(d.match)).data;
      return d.keys().hasAll(['uid','match','publicId','username','avatar','placement','kills','awardPaisa','revision','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['uid','match','publicId','username','avatar','placement','kills','awardPaisa','revision','updatedAt','updatedBy']) &&
        d.uid is string && d.match is string && id == d.uid + '_' + d.match && e.status == 'confirmed' &&
        e.uid == d.uid && e.match == d.match && d.username == e.username &&
        d.publicId is string && d.publicId.matches('[A-Za-z0-9]{20}') && d.avatar in ['solo','duo','squad'] &&
