      allow get: if activeAccount() && (resource == null || resource.data.uid == request.auth.uid || admin());
      allow list: if activeAccount() && (resource.data.uid == request.auth.uid || admin()) && (bounded() || admin());
      allow create: if activeAccount() && request.resource.data.keys().hasAll(['uid','requestId','amount','reference','sender','receiver','provider','currency','status','createdAt']) &&
        request.resource.data.keys().hasOnly(['uid','requestId','amount','reference','sender','receiver','provider','currency','status','createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.requestId is string && request.resource.data.requestId.matches('[A-Z0-9-]{6,80}') &&
        id == request.auth.uid + '_' + request.resource.data.requestId &&
        request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000 &&
        request.resource.data.reference is string && request.resource.data.reference.matches('[A-Z0-9-]{6,80}') &&
        request.resource.data.sender is string && request.resource.data.sender.matches('01[3-9][0-9]{8}') &&
        request.resource.data.provider == 'bkash' && request.resource.data.currency == 'BDT' && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/paymentInstructions/bkash) && get(/databases/$(database)/documents/paymentInstructions/bkash).data.get('enabled',false) == true && request.resource.data.receiver == get(/databases/$(database)/documents/paymentInstructions/bkash).data.number;
      allow update: if admin() && resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionReason','reviewedBy','reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time &&
        request.resource.data.decisionReason is string && request.resource.data.decisionReason.size() > 0 && request.resource.data.decisionReason.size() <= 1000 && request.resource.data.decisionReason.matches('(?s).*\\S.*') &&
        (request.resource.data.status == 'approved' ? liveCredit(id) : audited('live_deposit_' + id,'rejectDeposit','walletDeposits/' + id));
    }
    match /verifiedReceipts/{id} {
      allow get: if admin();
      allow create: if admin() && id == request.resource.data.receiver + '_' + request.resource.data.reference && liveCredit(request.resource.data.deposit);
    }
    match /walletLedger/{id} {
      allow read: if activeAccount() && (resource.data.uid == request.auth.uid || admin()) && (request.method == 'get' || bounded());
      allow create: if request.resource.data.get('type','') == 'deposit' && admin() && id == 'live_deposit_' + request.resource.data.deposit && liveCredit(request.resource.data.deposit);
      allow create: if request.resource.data.get('type','') == 'prize' && admin() && prizeLedgerAllowed(id);
      allow create: if request.resource.data.get('type','') == 'withdrawal' && admin() && withdrawalLedger(id);
      allow create: if activeAccount() && request.resource.data.keys().hasAll(['entry']) && paidLedger(id);
    }
    match /ledger/{id} { allow read: if activeAccount() && resource.data.uid == request.auth.uid; }
    match /depositRequests/{id} { allow read: if activeAccount() && (resource.data.uid == request.auth.uid || admin()); }
    match /{name}/{id} {
      allow read: if name in ['depositRequests','users'] && admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
