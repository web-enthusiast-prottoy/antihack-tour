{
  "name": "arena-announcements-admin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "emulators": "firebase emulators:start --project demo-arena --config ../firebase/firebase.json --only auth,firestore",
    "seed": "node ../firebase/scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --project demo-arena --config ../firebase/firebase.json --only firestore 'node --test ../firebase/tests/notices.test.mjs'"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
